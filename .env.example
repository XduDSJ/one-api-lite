PORT=3000
DEBUG=false
HTTPS_PROXY=http://localhost:7890

# 本地运行时产物（数据库、日志、编译二进制）统一存放到 .local/，避免散落根目录
# SQLite 数据库路径（默认 one-api.db 在根目录，建议指向 .local/data/）
SQLITE_PATH=.local/data/one-api.db
# 日志目录（命令行 --log-dir 也可指定，默认 ./logs）
# 启动示例: ./one-api --port 3000 --log-dir .local/logs
# 编译二进制建议输出到 .local/bin/: go build -o .local/bin/one-api.exe